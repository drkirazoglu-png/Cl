# Claude API anahtarı (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Webhook'u Meta'da kaydederken yazacağınız, kendi belirlediğiniz gizli kelime
WHATSAPP_VERIFY_TOKEN=bir-gizli-kelime
# App Settings > Basic > App Secret (webhook imzası doğrulaması için, önerilir)
WHATSAPP_APP_SECRET=

# İsteğe bağlı
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# DIALOGBRAIN_DB=dialogbrain.db
# SYSTEM_PROMPT=...
